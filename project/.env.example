# ChildHelper Server — environment variables
# Copy to .env and fill in your values

# Server port (default 8080)
PORT=8080

# --- Firebase Cloud Messaging ---
# Get these from your Firebase project:
#   1. Go to https://console.firebase.google.com/
#   2. Project Settings > Cloud Messaging > Cloud Messaging API (Legacy)
#   3. Or use a service account key for FCM HTTP v1
FCM_ACCESS_TOKEN=ya29.your-oauth2-access-token
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- TURN/STUN Servers ---
# For production, deploy your own TURN server (coturn recommended).
# These env vars control what credentials the /api/v1/turn/credentials endpoint returns.
TURN_SERVER_URL=turn:turn.childhelper.com:3478
TURN_USERNAME=childhelper
TURN_PASSWORD=use-a-random-32-char-string
STUN_SERVER_URL=stun:stun.l.google.com:19302

# --- TURN shared secret (for coturn dynamic auth) ---
TURN_SECRET=change-this-to-a-random-64-char-string
